// Grafana Alloy — unified local observability collector.
// Replaces Promtail (EOL). Handles logs, metrics, and traces.
//
// Logs: tails backend/logs/app.jsonl (bind-mounted read-only) → Loki.
// Metrics are scraped and remote-written to Prometheus.
// OTLP traces are received and forwarded to Tempo.

// ============================================================
// METRICS — scrape FastAPI backend → remote_write to Prometheus
// ============================================================

prometheus.scrape "tailord_backend" {
  targets = [{
    __address__ = "host.docker.internal:8000",
    job         = "tailord-backend",
  }]
  metrics_path    = "/metrics"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.local_prometheus.receiver]
}

prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ============================================================
// TRACES — receive OTLP → forward to Tempo
// ============================================================

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
  }
}

// ============================================================
// LOGS — tail backend/logs/app.jsonl → Loki
// ============================================================

local.file_match "tailord" {
  path_targets = [{
    __path__ = "/var/log/tailord/app.jsonl",
    job      = "tailord-backend",
  }]
}

loki.source.file "tailord" {
  targets    = local.file_match.tailord.targets
  forward_to = [loki.process.tailord.receiver]
}

loki.process "tailord" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level     = "level",
      logger    = "logger",
      timestamp = "timestamp",
    }
  }

  stage.labels {
    values = {
      level  = null,
      logger = null,
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
